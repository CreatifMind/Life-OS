# ==============================================================================
# LIFE OS — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env.local for local development, or add to Vercel Project Settings
# ==============================================================================

# User Profile & Localization
USER_NAME="Chris"
APP_TIMEZONE="Asia/Kuala_Lumpur"
TIMEZONE_OFFSET="+08:00"
NEXT_PUBLIC_USER_NAME="Chris"

# 1. Apple iCloud CalDAV (Calendar & Reminders)
# Generate from https://appleid.apple.com -> Sign-In and Security -> App-Specific Passwords
APPLE_ID="your-apple-id@gmail.com"
APPLE_APP_SPECIFIC_PASSWORD="xxxx-xxxx-xxxx-xxxx"

# 2. Google AI Studio (Gemini Free Tier API Key)
# Generate from https://aistudio.google.com/app/apikey
GEMINI_API_KEY="AIzaSy..."

# 3. Supabase Managed PostgreSQL
# From Supabase Dashboard -> Project Settings -> Database -> Connection string (URI)
DATABASE_URL="postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres"

# 4. Google Cloud OAuth 2.0 (Gmail API)
# From Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID="xxxx.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-xxxx"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/callback/google"
GOOGLE_REFRESH_TOKEN="1//xxxx"

# 5. Vercel Cron Security Secret (Optional for cron protection)
CRON_SECRET="your-random-32-char-cron-secret-string"
